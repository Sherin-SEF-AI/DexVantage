<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for signing DexVantage.app (packaging/macos/sign_and_notarise.sh,
     docs/packaging.md). A PyInstaller app loads Python extension modules and libraries signed by their own makers or
     not at all, so library validation is turned off. Unsigned executable memory is allowed for ctypes callbacks
     (libffi closures; PyOpenGL and MuJoCo's Python callbacks use them). Neither has been tried on a signed build of
     DexVantage yet: when the first signed build runs, try removing each and keep only what the app needs. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
