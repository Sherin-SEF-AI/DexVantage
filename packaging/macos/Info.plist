<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The macOS app's Info.plist entries (Apple silicon, arm64). packaging/dexvantage.spec reads this file, sets
     CFBundleShortVersionString and CFBundleVersion from dexvantage/__init__.py and hands it to PyInstaller's BUNDLE,
     which adds the executable, icon and package keys.
     LSMinimumSystemVersion 14.0: the newest arm64 wheels the bundle is built from need it (PyPI, read 2026-11-08:
     pyqt6 6.12.0 is cp310-abi3-macosx_14_0_universal2; numpy 2.5.4 and scipy 1.18.1, which pip prefers on macOS 14+,
     are macosx_14_0_arm64).
     LSBackgroundOnly false: COLLECT takes the console flag of its last launcher (dexvantage-cli), which would make
     PyInstaller mark the app background-only (no Dock icon, no menu bar). -->
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key>
  <string>io.github.sherin-sef-ai.dexvantage</string>
  <key>CFBundleName</key>
  <string>DexVantage</string>
  <key>CFBundleDisplayName</key>
  <string>DexVantage</string>
  <key>CFBundleShortVersionString</key>
  <string>0.0.0</string>
  <key>CFBundleVersion</key>
  <string>0.0.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.developer-tools</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSArchitecturePriority</key>
  <array>
    <string>arm64</string>
  </array>
  <key>LSBackgroundOnly</key>
  <false/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>io.github.sherin-sef-ai.dexvantage.project</string>
      <key>UTTypeDescription</key>
      <string>DexVantage project</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>dexvantage.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>dexv</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-dexvantage-project</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>DexVantage project</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>io.github.sherin-sef-ai.dexvantage.project</string>
      </array>
      <key>CFBundleTypeIconFile</key>
      <string>dexvantage.icns</string>
    </dict>
  </array>
</dict>
</plist>
