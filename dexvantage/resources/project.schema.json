{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sherin-sef-ai.github.io/DexVantage/project.schema.json",
  "title": "DexVantage project (project.json inside a .dexv archive)",
  "description": "Version 1. Units are SI (metres, seconds, kilograms); joint values in radians; quaternions (x, y, z, w); frames follow REP-103. See docs/project-format.md.",
  "type": "object",
  "required": ["format", "version", "name", "robots", "workspace", "tasks", "variants", "active_uid", "requirements", "analysis"],
  "properties": {
    "format": {"const": "dexvantage.project"},
    "version": {"type": "integer", "minimum": 1},
    "name": {"type": "string"},
    "notes": {"type": "string"},
    "created": {"type": "string"},
    "saved_at": {"type": "string"},
    "robots": {"type": "array", "items": {"$ref": "#/$defs/robot"}},
    "workspace": {"$ref": "#/$defs/workspace"},
    "tasks": {"$ref": "#/$defs/tasks"},
    "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}},
    "active_uid": {"$ref": "#/$defs/uid"},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "analysis": {"$ref": "#/$defs/analysis"},
    "rig": {"type": "object", "description": "The host topology (core/studies/bandwidth.py, docs/models/bandwidth.md): hosts with their controllers, hubs, and the link of each sensor.",
      "properties": {
        "hosts": {"type": "array", "items": {"type": "object", "required": ["uid", "name", "controllers"], "properties": {
          "uid": {"type": "string"}, "name": {"type": "string"}, "library_id": {"type": "string", "description": "a host library entry, or empty"},
          "controllers": {"type": "array", "items": {"type": "object", "required": ["uid", "name", "kind"], "properties": {
            "uid": {"type": "string"}, "name": {"type": "string"}, "kind": {"enum": ["usb3", "usb2", "pcie", "gmsl"]},
            "practical_mbps": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "Mbit/s the controller carries in practice; null when no source states it"},
            "source": {"type": "string", "description": "where practical_mbps comes from (a measurement or a document)"}}}}}}},
        "hubs": {"type": "array", "items": {"type": "object", "required": ["uid", "name", "powered", "upstream"], "properties": {
          "uid": {"type": "string"}, "name": {"type": "string"}, "powered": {"type": "boolean"},
          "upstream": {"type": "string", "description": "the controller or hub uid it plugs into"}}}},
        "links": {"type": "array", "items": {"type": "object", "required": ["sensor_uid", "via"], "properties": {
          "sensor_uid": {"type": "string"}, "stream_ids": {"type": "array", "items": {"type": "string"}, "description": "imager|WxH|fps|format; empty = the default streams"},
          "via": {"type": "string", "description": "the controller or hub uid"}, "cable_uid": {"type": "string"}}}},
        "sync": {"type": "object", "description": "Time sync (core/studies/time_sync.py, docs/models/time_sync.md): the rig's clocks, with the figures their sources state, and each stream's clock and trigger.",
          "properties": {
            "clocks": {"type": "array", "items": {"type": "object", "required": ["uid", "name", "kind"], "properties": {
              "uid": {"type": "string"}, "name": {"type": "string"}, "kind": {"enum": ["camera_hw", "host", "ptp", "ntp", "robot"]},
              "offset_s": {"$ref": "#/$defs/sourced_number"}, "jitter_s": {"$ref": "#/$defs/sourced_number"}, "drift_ppm": {"$ref": "#/$defs/sourced_number"}}}},
            "streams": {"type": "object", "description": "sensor uid or 'joint_states' -> its clock and trigger",
              "additionalProperties": {"type": "object", "properties": {
                "clock": {"type": "string", "description": "a clock uid; empty: stamped on arrival by the host"},
                "trigger": {"enum": ["free", "hardware", "sync_cable"]}}}}}}
      }},
    "cables": {"type": "array", "description": "Cables across the robot's joints (core/cables.py, docs/models/cables.md). Lengths and radii in metres; points in the link frame.",
      "items": {"type": "object", "required": ["uid", "name", "attachments"], "properties": {
        "uid": {"type": "string"}, "name": {"type": "string"}, "sensor_uid": {"type": "string"},
        "type": {"enum": ["usb3", "usb2", "gmsl2", "gmsl", "coax", "ethernet", "power", "other"]},
        "library_id": {"type": "string", "description": "a cable library entry, or empty"},
        "min_bend_radius_m": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["value", "source"], "properties": {
          "value": {"type": "number", "exclusiveMinimum": 0}, "source": {"type": "string"},
          "kind": {"enum": ["dynamic", "static", "unspecified"]}}}], "description": "null: not stated"},
        "diameter_m": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "length_m": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "the cable's provided length"},
        "wrap_radius_m": {"type": ["number", "null"], "minimum": 0, "description": "null: the default (the nearer attachment's distance from the axis)"},
        "attachments": {"type": "array", "items": {"type": "object", "required": ["robot_uid", "link", "point"], "properties": {
          "robot_uid": {"type": "string"}, "link": {"type": "string"}, "point": {"$ref": "#/$defs/vec3"},
          "length_to_next_m": {"type": ["number", "null"], "exclusiveMinimum": 0, "description": "the cable laid to the next attachment; null: not set"}}}},
        "connectors": {"type": "array", "items": {"type": "string"}},
        "strain_relief": {"type": "string"}, "note": {"type": "string"}}}},
    "policies": {"type": "array", "description": "The policies the data is for (core/policies.py, docs/models/policies.md): a policy library entry, the cameras it takes and the user's own figures over the entry's.",
      "items": {"type": "object", "required": ["uid", "name", "library_id"], "properties": {
        "uid": {"$ref": "#/$defs/uid"}, "name": {"type": "string"},
        "library_id": {"type": "string", "description": "a library entry of kind policy"},
        "cameras": {"type": "array", "items": {"type": "string"}, "description": "sensor uids; empty = every camera and depth sensor of the rig"},
        "overrides": {"type": "object", "description": "field -> the user's figure and where it comes from",
          "additionalProperties": {"type": "object", "required": ["value", "source"], "properties": {
            "value": {}, "source": {"type": "string", "minLength": 1, "description": "e.g. measured by the user ..."}}}},
        "recommendations": {"type": "object", "description": "training-config recommendations a study stored (core/studies/action_chunk_sync.py: delay_offset_s, temporal_ensemble_m), each with its value and where it comes from",
          "additionalProperties": {"type": "object", "required": ["value", "source"], "properties": {
            "value": {}, "source": {"type": "string"}}}}}}},
    "calibration": {"type": "object", "description": "Hand-eye calibration (core/calib/records.py, docs/models/handeye.md): boards with their placement, and capture sessions (planned or recorded poses, detections and the solve). Units: metres, radians, pixels (OpenCV pixel centres).",
      "properties": {
        "boards": {"type": "array", "items": {"type": "object", "required": ["uid", "board", "mount"], "properties": {
          "uid": {"type": "string"}, "name": {"type": "string"},
          "board": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["charuco", "aprilgrid"]}}, "description": "the board's figures (core/calib/boards.py to_dict)"},
          "mount": {"type": "object", "properties": {"parent_frame": {"type": "string"}, "robot_uid": {"type": "string"}, "pose": {"$ref": "#/$defs/pose"}}, "description": "the board frame in the world, a static frame or a robot link"},
          "default": {"type": "boolean", "description": "the placement is DexVantage's default, not the user's"}}}},
        "sessions": {"type": "array", "items": {"type": "object", "required": ["uid", "sensor_uid", "mode", "poses"], "properties": {
          "uid": {"type": "string"}, "name": {"type": "string"}, "sensor_uid": {"type": "string"}, "imager": {"type": "string"},
          "mode": {"enum": ["eye_in_hand", "eye_to_hand"]}, "board_uid": {"type": "string"}, "robot_uid": {"type": "string"}, "link": {"type": "string"},
          "created": {"type": "string"}, "source": {"type": "object"}, "settings": {"type": "object"},
          "poses": {"type": "array", "items": {"type": "object", "properties": {
            "name": {"type": "string"}, "q": {"type": "array", "items": {"type": "number"}, "description": "the robot's joint vector, its model's joint order"},
            "joint_names": {"type": "array", "items": {"type": "string"}}, "image": {"type": "string", "description": "file name, no folder"},
            "t_image": {"type": ["number", "null"]}, "t_joints": {"type": ["number", "null"]}, "dt_s": {"type": ["number", "null"]},
            "ids": {"type": "array", "items": {"type": "integer"}}, "uv": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
            "note": {"type": "string"}}}},
          "result": {"type": "object", "description": "the solve (schema dexvantage.handeye/1) and whether it was applied"}}}}
      }},
    "data": {"type": "object", "description": "Recorded datasets the project audits and the audit's requirements (core/audit, docs/models/audit.md). A dataset's path is the one the user chose; requirements are the user's values over the labelled defaults of core/audit/episode.py REQUIREMENTS and SETTINGS.",
      "properties": {
        "datasets": {"type": "array", "items": {"type": "object", "required": ["uid", "path"], "properties": {
          "uid": {"type": "string"}, "name": {"type": "string"}, "path": {"type": "string"},
          "format": {"type": "string", "description": "lerobot | rlds | mcap | rosbag2-sqlite"}, "version": {"type": "string"},
          "episodes": {"type": ["integer", "null"], "minimum": 0},
          "cameras": {"type": "object", "additionalProperties": {"type": "string"}, "description": "dataset camera key -> sensor uid (overrides matching by name)"},
          "exclude": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "episodes the audit's Apply marked to drop or re-record"}}}},
        "requirements": {"type": "object", "description": "requirement or detection setting id -> value (a number, or [low, high] for action_lag_rows)"}}},
    "log": {"type": "array", "items": {"type": "object", "properties": {"t": {"type": "string"}, "kind": {"type": "string"}, "text": {"type": "string"}}, "required": ["t", "kind", "text"]}},
    "meshes": {"type": "array", "items": {"type": "string"}, "description": "keys of the arrays in meshes.npz"},
    "sources": {"type": "array", "items": {"type": "string"}, "description": "file names under sources/"}
  },
  "$defs": {
    "uid": {"type": "string", "pattern": "^[0-9a-f]{10}$"},
    "sourced_number": {"description": "a figure and where it comes from; null: not stated", "oneOf": [{"type": "null"}, {"type": "object", "required": ["value", "source"], "properties": {"value": {"type": "number"}, "source": {"type": "string"}}}]},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "quat": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "(x, y, z, w), unit length"},
    "pose": {
      "type": "object", "required": ["position", "quaternion"],
      "properties": {"position": {"$ref": "#/$defs/vec3"}, "quaternion": {"$ref": "#/$defs/quat"}}
    },
    "robot": {
      "type": "object", "required": ["uid", "name", "source", "base", "primary", "links", "joints"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"},
        "name": {"type": "string"},
        "source": {"type": "object", "properties": {
          "kind": {"enum": ["", "urdf", "mjcf", "usd"]}, "file": {"type": "string"}, "sha256": {"type": "string"},
          "license": {"type": "string"}, "note": {"type": "string"}}},
        "base": {"$ref": "#/$defs/pose"},
        "primary": {"type": "boolean"},
        "links": {"type": "array", "items": {"type": "object"}},
        "joints": {"type": "array", "items": {"type": "object"}},
        "home": {"type": "object", "additionalProperties": {"type": "number"}},
        "gripper_frame": {"type": "string"},
        "fingertip_frames": {"type": "array", "items": {"type": "string"}},
        "contact_pads": {"type": "array", "items": {"type": "object"}},
        "locked": {"type": "boolean"}
      }
    },
    "mount": {
      "type": "object", "required": ["parent_frame", "robot_uid", "pose", "tolerance"],
      "properties": {
        "parent_frame": {"type": "string", "description": "world, a static frame (cage, tripod, table) or a link name"},
        "robot_uid": {"type": "string"},
        "pose": {"$ref": "#/$defs/pose"},
        "tolerance": {"type": "object", "properties": {"position_mm": {"type": "number", "minimum": 0}, "rotation_deg": {"type": "number", "minimum": 0}}},
        "bracket": {"type": "string"}
      }
    },
    "sensor": {
      "type": "object", "required": ["uid", "name", "kind", "mount"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"},
        "name": {"type": "string"},
        "kind": {"enum": ["camera", "depth", "tactile"]},
        "model_id": {"type": "string"},
        "calibration": {"type": "object"},
        "mount": {"$ref": "#/$defs/mount"},
        "slot": {"type": "integer", "minimum": 0},
        "locked": {"type": "boolean"},
        "enabled": {"type": "boolean"},
        "stream": {"type": "array", "items": {"type": "integer", "minimum": 1}, "maxItems": 2}
      }
    },
    "variant": {
      "type": "object", "required": ["uid", "name", "sensors"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"}, "name": {"type": "string"},
        "sensors": {"type": "array", "items": {"$ref": "#/$defs/sensor"}},
        "note": {"type": "string"}, "created": {"type": "string"}
      }
    },
    "volume": {
      "type": "object", "required": ["uid", "name", "kind", "center", "size"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"}, "name": {"type": "string"},
        "kind": {"enum": ["tabletop", "shelf", "bin", "handover", "custom"]},
        "center": {"$ref": "#/$defs/vec3"},
        "size": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 3, "maxItems": 3},
        "refine": {"type": "boolean"}
      }
    },
    "object": {
      "type": "object", "required": ["uid", "name", "shape", "size", "pose", "materials"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"}, "name": {"type": "string"},
        "shape": {"enum": ["box", "cylinder", "sphere", "mesh"]},
        "size": {"$ref": "#/$defs/vec3"}, "pose": {"$ref": "#/$defs/pose"}, "mesh_key": {"type": "string"},
        "materials": {"type": "array", "items": {"enum": ["matte", "glossy", "metallic", "transparent", "black", "ir_absorbing"]}}
      }
    },
    "workspace": {
      "type": "object", "required": ["volumes", "objects"],
      "properties": {
        "volumes": {"type": "array", "items": {"$ref": "#/$defs/volume"}},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
        "lights": {"type": "array", "items": {"type": "object"}},
        "surfaces": {"type": "array", "items": {"type": "object"}},
        "background": {"type": "string"}
      }
    },
    "tasks": {
      "type": "object",
      "properties": {
        "grasp_sets": {"type": "array", "items": {"type": "object"}},
        "trajectories": {"type": "array", "items": {"type": "object"}},
        "teleop_devices": {"type": "array", "items": {"type": "object"}}
      }
    },
    "requirement": {
      "type": "object", "required": ["uid", "metric", "op", "threshold", "is_default"],
      "properties": {
        "uid": {"$ref": "#/$defs/uid"}, "name": {"type": "string"}, "metric": {"type": "string"},
        "op": {"enum": [">=", "<=", "<", ">", "=="]}, "threshold": {"type": "number"}, "unit": {"type": "string"},
        "study": {"type": "string"}, "is_default": {"type": "boolean"}, "note": {"type": "string"}
      }
    },
    "analysis": {
      "type": "object", "required": ["voxel_mm", "refine_mm"],
      "properties": {
        "voxel_mm": {"type": "number", "exclusiveMinimum": 0},
        "refine_mm": {"type": "number", "exclusiveMinimum": 0},
        "live": {"type": "boolean"},
        "studies": {"type": "object"}
      }
    }
  }
}
